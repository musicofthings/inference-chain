{
	"SessionStart": [
		{
			"hooks": [
				{
					"type": "command",
					"command": "test -f .inference-chain/resumes/resume_latest.md && cat .inference-chain/resumes/resume_latest.md || true"
				}
			]
		}
	],
	"PreCompact": [
		{
			"hooks": [
				{
					"type": "command",
					"command": "ic sync --quiet || true; echo '[inference-chain] Consider /ic-checkpoint before compaction to preserve operating context.'"
				}
			]
		}
	],
	"Stop": [
		{
			"hooks": [
				{
					"type": "command",
					"command": "ic sync --quiet || true"
				}
			]
		}
	]
}
